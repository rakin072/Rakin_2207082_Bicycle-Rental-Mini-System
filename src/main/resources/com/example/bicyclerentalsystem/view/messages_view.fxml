<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bicyclerentalsystem.controller.MessagesController"
            stylesheets="@../css/style.css"
            fitToWidth="true"
            style="-fx-background-color: #0f172a; -fx-background: #0f172a;">

    <VBox spacing="25"
          style="-fx-background-color: #0f172a;">
        <padding>
            <javafx.geometry.Insets top="25" right="25" bottom="25" left="25"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="💬 Messages &amp; Communication" styleClass="title-label"
                   style="-fx-font-size: 28px;"/>
            <javafx.scene.layout.Pane HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Back to Dashboard" styleClass="nav-button" onAction="#backToDashboard"
                    prefHeight="40" prefWidth="200"/>
        </HBox>

        <!-- Send Message Section -->
        <VBox spacing="18" styleClass="card" style="-fx-padding: 25; -fx-background-radius: 12;">
            <Label text="📤 Send Message to Bicycle Owner" styleClass="sub-title"
                   style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #10b981;"/>

            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="60"/>
                    <ColumnConstraints percentWidth="40"/>
                </columnConstraints>

                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Select Your Active Rental:" style="-fx-font-weight: 600; -fx-font-size: 14px;"/>
                    <ComboBox fx:id="rentalDropdown" promptText="Choose a rental..." styleClass="combo-box"
                              prefHeight="50" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Transaction ID:" style="-fx-font-weight: 600; -fx-font-size: 14px;"/>
                    <TextField fx:id="txIdField" promptText="e.g., TX:12345" styleClass="text-field"
                               prefHeight="50"/>
                </VBox>
            </GridPane>

            <VBox spacing="8">
                <Label text="Your Message:" style="-fx-font-weight: 600; -fx-font-size: 14px;"/>
                <TextArea fx:id="messageArea" promptText="Type your message to the bicycle owner here..."
                          prefHeight="100" wrapText="true" styleClass="text-field"
                          style="-fx-font-size: 14px;"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="📨 Send Message" styleClass="button-primary-large" onAction="#sendMessage"
                        prefHeight="50" prefWidth="200"/>
                <Button text="💳 Pay Overdue Charges" styleClass="button-secondary" onAction="#sendOverduePayment"
                        prefHeight="50" prefWidth="200"/>
                <Label text="Send payment confirmation to bicycle owner or pay overdue charges"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            </HBox>
        </VBox>

        <!-- Sent Messages Section -->
        <VBox spacing="15" styleClass="card" style="-fx-padding: 25; -fx-background-radius: 12;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📬 Your Sent Messages" styleClass="sub-title"
                       style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #3b82f6;"/>
                <Label fx:id="sentCountLabel" text="(0)"
                       style="-fx-text-fill: #64748b; -fx-font-size: 16px; -fx-font-weight: 600;"/>
            </HBox>
            <Separator style="-fx-background-color: #475569;"/>
            <TableView fx:id="sentMessagesTable" prefHeight="220" styleClass="table-view">
                <columnResizePolicy><javafx.scene.control.TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                <columns>
                    <TableColumn text="Bicycle Model" fx:id="colSentBicycle" prefWidth="180"/>
                    <TableColumn text="Owner" fx:id="colSentTo" prefWidth="140"/>
                    <TableColumn text="Transaction ID" fx:id="colSentTxId" prefWidth="140"/>
                    <TableColumn text="Status/Response" fx:id="colSentResponse" prefWidth="180"/>
                    <TableColumn text="Sent On" fx:id="colSentDate" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Received Messages Section -->
        <VBox spacing="15" styleClass="card" style="-fx-padding: 25; -fx-background-radius: 12;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📥 Messages Received" styleClass="sub-title"
                       style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #f59e0b;"/>
                <Label fx:id="receivedCountLabel" text="(0 pending)"
                       style="-fx-text-fill: #64748b; -fx-font-size: 16px; -fx-font-weight: 600;"/>
            </HBox>
            <Separator style="-fx-background-color: #475569;"/>
            <TableView fx:id="receivedMessagesTable" prefHeight="220" styleClass="table-view">
                <columnResizePolicy><javafx.scene.control.TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                <columns>
                    <TableColumn text="Bicycle Model" fx:id="colReceivedBicycle" prefWidth="180"/>
                    <TableColumn text="Renter" fx:id="colReceivedFrom" prefWidth="140"/>
                    <TableColumn text="Transaction ID" fx:id="colReceivedTxId" prefWidth="140"/>
                    <TableColumn text="Message" fx:id="colReceivedMessage" prefWidth="250"/>
                    <TableColumn text="Received On" fx:id="colReceivedDate" prefWidth="150"/>
                </columns>
            </TableView>

            <Separator style="-fx-background-color: #475569;"/>

            <VBox spacing="12">
                <Label text="💡 Respond to Selected Message:"
                       style="-fx-font-weight: 700; -fx-font-size: 15px; -fx-text-fill: #e2e8f0;"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="✅ Yes" styleClass="button-primary-large"
                            onAction="#respondYes" prefHeight="50" prefWidth="140"/>
                    <Button text="❌ No" styleClass="button-danger"
                            onAction="#respondNo" prefHeight="50" prefWidth="140"/>
                    <Label text="Select a message from the table above to respond"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-style: italic;"/>
                </HBox>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>
