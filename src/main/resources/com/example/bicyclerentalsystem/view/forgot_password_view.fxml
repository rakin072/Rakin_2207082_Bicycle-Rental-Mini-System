<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bicyclerentalsystem.controller.ForgotPasswordController"
            stylesheets="@../css/style.css"
            prefWidth="450" prefHeight="500">

    <VBox alignment="CENTER" spacing="25"
          AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30"
          AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="🔐" style="-fx-font-size: 42px;"/>
            <Label text="Reset Password" styleClass="title-label"/>
            <Label text="Enter your username and password hint" 
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Reset Form -->
        <VBox spacing="18" prefWidth="350">
            <VBox spacing="8">
                <Label text="Username" styleClass="sub-title"/>
                <TextField fx:id="usernameField" 
                           promptText="Enter your username" 
                           styleClass="text-field"
                           prefHeight="45"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Password Hint" styleClass="sub-title"/>
                <TextField fx:id="hintField" 
                           promptText="Enter the hint you provided" 
                           styleClass="text-field"
                           prefHeight="45"/>
            </VBox>

            <VBox spacing="8">
                <Label text="New Password" styleClass="sub-title"/>
                <PasswordField fx:id="newPasswordField" 
                               promptText="Enter new password" 
                               styleClass="password-field"
                               prefHeight="45"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Confirm New Password" styleClass="sub-title"/>
                <PasswordField fx:id="confirmPasswordField" 
                               promptText="Re-enter new password" 
                               styleClass="password-field"
                               prefHeight="45"/>
            </VBox>

            <Label fx:id="messageLabel" styleClass="label-error" 
                   alignment="CENTER" prefWidth="350" wrapText="true"/>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Reset Password" fx:id="resetButton"
                        onAction="#handleResetPassword"
                        styleClass="button-primary"
                        prefWidth="160"
                        prefHeight="45"/>
                <Button text="Cancel" fx:id="cancelButton"
                        onAction="#handleCancel"
                        styleClass="button-secondary"
                        prefWidth="160"
                        prefHeight="45"/>
            </HBox>
        </VBox>
    </VBox>

</AnchorPane>
