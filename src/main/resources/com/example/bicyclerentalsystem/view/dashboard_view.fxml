<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bicyclerentalsystem.controller.DashboardController"
            stylesheets="@../css/style.css"
            prefWidth="1200" prefHeight="800">

    <!-- Top Toolbar -->
    <top>
        <ToolBar styleClass="tool-bar">
            <Button text="📊 Dashboard" onAction="#showDashboard" styleClass="nav-button"/>
            <Button text="🚴 Bicycles" onAction="#showBicycles" styleClass="nav-button"/>
            <Button text="📝 Rentals" onAction="#showRentals" styleClass="nav-button"/>
            <Button text="⏰ Overdue" onAction="#showOverdue" styleClass="nav-button"/>
            <Button text="💬 Messages" onAction="#showMessages" styleClass="nav-button"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button text="🚪 Logout" onAction="#logout" styleClass="button-danger"/>
        </ToolBar>
    </top>

    <!-- Center Content Area -->
    <center>
        <BorderPane fx:id="contentPane" styleClass="root">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </BorderPane>
    </center>

</BorderPane>
