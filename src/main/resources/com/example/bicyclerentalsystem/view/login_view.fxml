<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bicyclerentalsystem.controller.LoginController"
            stylesheets="@../css/style.css"
            prefWidth="500" prefHeight="600">

    <VBox alignment="CENTER" spacing="25"
          AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50"
          AnchorPane.topAnchor="80" AnchorPane.bottomAnchor="80">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="🚴" style="-fx-font-size: 48px;"/>
            <Label text="Bicycle Rental System" styleClass="title-label"/>
            <Label text="Welcome back! Please login to continue" 
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Login Form -->
        <VBox spacing="20" prefWidth="380">
            <VBox spacing="8">
                <Label text="Username" styleClass="sub-title"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           styleClass="text-field"
                           prefHeight="50"/>
            </VBox>

            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Password" styleClass="sub-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Forgot Password?" 
                               onAction="#handleForgotPassword"
                               style="-fx-font-size: 12px; -fx-text-fill: #3b82f6;"/>
                </HBox>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="password-field"
                               prefHeight="50"/>
            </VBox>

            <Button text="🔐 Login" fx:id="loginButton"
                    onAction="#handleLogin"
                    styleClass="button-primary-large"
                    prefWidth="380"
                    prefHeight="50"/>

            <Label fx:id="messageLabel" styleClass="label-error" 
                   alignment="CENTER" prefWidth="380"/>
        </VBox>

        <!-- Register Link -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" 
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            <Hyperlink text="Create one now"
                       onAction="#goToRegister"
                       style="-fx-font-size: 14px; -fx-font-weight: 600;"/>
        </VBox>
    </VBox>

</AnchorPane>
