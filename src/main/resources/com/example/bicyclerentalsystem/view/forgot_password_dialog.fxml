<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bicyclerentalsystem.controller.ForgotPasswordController"
            stylesheets="@../css/style.css"
            prefWidth="450" prefHeight="500">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="🔐" style="-fx-font-size: 40px;"/>
            <Label text="Forgot Password?" styleClass="title-label"/>
            <Label text="Enter your password hint to recover" 
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Step 1: Hint Input -->
        <VBox fx:id="hintSection" spacing="15" prefWidth="380">
              
            <VBox spacing="8" alignment="CENTER" 
                  style="-fx-background-color: #fff3cd; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #ffc107; -fx-border-width: 1; -fx-border-radius: 8;">
                <Label text="🔑 Verify Your Identity" 
                       style="-fx-font-size: 13px; -fx-text-fill: #856404; -fx-font-weight: 600;"/>
                <Label text="Please enter the hint you provided during registration" 
                       wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: #856404; -fx-text-alignment: center;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Your Password Hint" styleClass="sub-title"/>
                <TextField fx:id="hintInputField" 
                           promptText="Enter the hint you gave during registration" 
                           styleClass="text-field"
                           prefHeight="45"/>
            </VBox>

            <Button text="Verify Hint" 
                    onAction="#handleVerifyHint"
                    styleClass="button-primary-large"
                    prefWidth="380"
                    prefHeight="45"/>
        </VBox>

        <!-- Step 2: Password Reset -->
        <VBox fx:id="resetSection" spacing="15" prefWidth="380" 
              visible="false" managed="false">
              
            <VBox spacing="8" alignment="CENTER" 
                  style="-fx-background-color: #d1fae5; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #10b981; -fx-border-width: 1; -fx-border-radius: 8;">
                <Label text="✅ Identity Verified" 
                       style="-fx-font-size: 13px; -fx-text-fill: #065f46; -fx-font-weight: 600;"/>
                <Label text="You can now reset your password" 
                       style="-fx-font-size: 12px; -fx-text-fill: #065f46;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="New Password" styleClass="sub-title"/>
                <PasswordField fx:id="newPasswordField" 
                               promptText="Enter new password" 
                               styleClass="password-field"
                               prefHeight="45"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Confirm New Password" styleClass="sub-title"/>
                <PasswordField fx:id="confirmPasswordField" 
                               promptText="Re-enter new password" 
                               styleClass="password-field"
                               prefHeight="45"/>
            </VBox>

            <Button text="Reset Password" 
                    onAction="#handleResetPassword"
                    styleClass="button-primary-large"
                    prefWidth="380"
                    prefHeight="45"/>
        </VBox>

        <Label fx:id="messageLabel" styleClass="label-error" 
               alignment="CENTER" prefWidth="380" wrapText="true"/>

        <!-- Cancel Button -->
        <Button text="Cancel" 
                onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-cursor: hand;"
                prefWidth="100"/>
    </VBox>

</AnchorPane>
